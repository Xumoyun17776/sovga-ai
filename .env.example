# =========================================================================
# SOVG'A AI - ENVIRONMENT CONFIGURATION (EXAMPLE)
# =========================================================================

# --- SERVER CONFIGURATION ---
PORT=3000
NODE_ENV=development

# --- DATABASE (PostgreSQL) ---
# Replace with your actual PostgreSQL connection string (e.g. Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/sovga_db

# --- SECURITY & AUTHENTICATION ---
# Secret key used for signing session cookies. Use a long, random string in production.
SESSION_SECRET=your_super_secret_session_key_here

# --- AI WEB SEARCH ---
# Used to search the web (Uzum, Asaxiy, MediaPark and other stores) for what a shopper types.
# Olcha and Texnomart are searched directly and work without any key.
# Check which key works at: GET /api/health  (aiWebSearch section)
# Google Gemini with Google Search grounding (free tier has a small daily limit; enable billing for real traffic)
GEMINI_API_KEY=AIzaSy...
# Optional: comma-separated models to try in order
# GEMINI_MODEL=gemini-3.8-flash,gemini-flash-latest
# OpenAI with web search (used first when this key is valid)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- PAYMENT INTEGRATIONS (Sandbox) ---
# CLICK_MERCHANT_ID=...
# PAYME_MERCHANT_ID=...

# --- SMS LOGIN CODES (Eskiz.uz) ---
# Without these, login codes are shown on screen only in development (or with OTP_DEMO_MODE=true).
# ESKIZ_SMS_EMAIL=...
# ESKIZ_SMS_PASSWORD=...
# ESKIZ_FROM=4546
# The text must match a template approved in your Eskiz cabinet; {code} is replaced with the code.
# ESKIZ_OTP_TEMPLATE=Sovg'a.uz: tasdiqlash kodi {code}
# OTP_DEMO_MODE=false
